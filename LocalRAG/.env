# ── Ollama Configuration ───────────────────────────────────────────────────
# Ollama server URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Embedding model - nomic-embed-text is fast and good quality
# Run: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# Chat model - llama3.2 is a good balance of speed and quality, tinyllama is faster but less accurate
# Run: ollama pull llama3.2
CHAT_MODEL=tinyllama

# SQLite database path for storing vectors
DB_PATH=vectors.db
